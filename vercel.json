{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "includeFiles": "{*.php,admin/**,config/**,includes/**}"
    }
  },
  "routes": [
    { "src": "/", "dest": "/api/index.php?__path=index.php" },
    { "src": "/admin/?", "dest": "/api/index.php?__path=admin/login.php" },
    { "src": "/(.*\\.php)", "dest": "/api/index.php?__path=$1" },
    { "src": "/(config|includes|api)/.*", "status": 404, "dest": "/404" }
  ]
}
